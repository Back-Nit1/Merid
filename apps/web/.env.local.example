# Copy this file to .env.local for local development (.env.local is
# gitignored — never commit it).
#
# NEXT_PUBLIC_* vars are shipped to the browser. Never put secrets here —
# Fireworks/ElevenLabs/Braintrust/Daytona keys live server-side only, on the
# FastAPI backend, not in this app.

# Base URL of the Meridian FastAPI backend. In production this is the
# Vercel-configured tunnel/host (see CLAUDE.md's Deployment section).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Flags the UI as demo-only. Keep true everywhere this app is deployed —
# there is no production, non-demo mode for this project.
NEXT_PUBLIC_DEMO_MODE=true

# --- CopilotKit (nurse worklist assistant) ---------------------------------
# Server-side ONLY. Note the deliberate absence of a NEXT_PUBLIC_ prefix: this
# key is read inside src/app/api/copilotkit/route.ts, which runs on the server,
# and must never reach the browser. Same key as the backend's Fireworks key.
# Unset = the copilot degrades to a no-op; the worklist still renders.
FIREWORKS_API_KEY=

# Model backing the copilot. An instruct model is the right pick here (short
# conversational turns); the heavier reasoning model used for extraction is
# unnecessary and slower for this.
COPILOT_MODEL=accounts/fireworks/models/llama-v3p1-70b-instruct
